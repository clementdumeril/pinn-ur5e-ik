#VRML_SIM R2023a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023a/projects/appearances/protos/Parquetry.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023a/projects/objects/tables/protos/Table.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023a/projects/robots/universal_robots/protos/UR5e.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023a/projects/robots/franka_emika/panda/protos/PandaHand.proto"

WorldInfo {
  # 32 ms (le defaut Webots) est trop grossier pour les contacts de la pince :
  # physique instable, bras qui vibre pendant les mesures, prise qui glisse.
  basicTimeStep 8
}
Viewpoint {
  orientation -0.21 -0.12 0.96 4.0
  position 1.0 4.5 4.5
}
TexturedBackground {
  texture "factory"
}
TexturedBackgroundLight {
  luminosity 0.7
}
RectangleArena {
  floorSize 12 12
  floorTileSize 2 2
  floorAppearance Parquetry {
    type "light strip"
  }
  wallHeight 1.2
}

# ==========================================
# SUPERVISOR CONTROLLER (Orchestrateur)
# ==========================================
Robot {
  name "Orchestrator"
  controller "comparison_controller"
  supervisor TRUE
}

# ==========================================
# POSTE 1 : TRUE PINN (ROBOT SOLIDE) - Y = 0
# ==========================================
DEF UR5E_PINN UR5e {
  name "UR5e_PINN"
  translation -2.28 0 0.9
  rotation 0 0 -1 -1.5707953071795862
  controller "ur5_controller_pandahand"
  controllerArgs [
    "pinn"
  ]
  supervisor TRUE
  toolSlot [
    Transform {
      translation 0 0.1034 0
      rotation 1 0 0 -1.5708
      children [
        DEF frame6 Transform {
          rotation 0 0 1 1.5708
          children [
            DEF frame_6 Slot { }
          ]
        }
      ]
    }
    Transform {
      rotation 1 0 0 -1.5708
      children [ PandaHand { } ]
    }
  ]
}

DEF table1 Table {
  translation -1.5 0 0
  name "table1"
  size 0.8 1.4 0.9
}
DEF table2 Table {
  translation -2.28 0 0
  name "table2"
  size 0.9 1.6 0.9
}
DEF RED_BOX_PINN Solid {
  translation -1.55 0.2 0.955
  children [
    Shape {
      appearance PBRAppearance { baseColor 1 0 0 roughness 0.5 }
      geometry Box { size 0.05 0.05 0.1 }
    }
  ]
  name "red_box_pinn"
  boundingObject Box { size 0.05 0.05 0.1 }
  physics Physics { density 500 }
}
DEF BLUE_TRAY_PINN Solid {
  translation -1.55 -0.2 0.901
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.1 0.3 1 transparency 0.3 roughness 0.8 }
      geometry Box { size 0.25 0.25 0.01 }
    }
  ]
  name "blue_tray_pinn"
  boundingObject Box { size 0.25 0.25 0.01 }
}

# ==========================================
# POSTE 2 : MATH IKPY (ROBOT 2) - Y = 1.5
# ==========================================
DEF UR5E_MATH UR5e {
  name "UR5e_MATH"
  translation -2.28 1.5 0.9
  rotation 0 0 -1 -1.5707953071795862
  controller "ur5_controller_pandahand"
  controllerArgs [
    "math"
  ]
  supervisor TRUE
  toolSlot [
    Transform {
      translation 0 0.1034 0
      rotation 1 0 0 -1.5708
      children [
        DEF frame6 Transform {
          rotation 0 0 1 1.5708
          children [ DEF frame_6 Slot { } ]
        }
      ]
    }
    Transform {
      rotation 1 0 0 -1.5708
      children [ PandaHand { } ]
    }
  ]
}

DEF table1_math Table {
  translation -1.5 1.5 0
  name "table1_math"
  size 0.8 1.4 0.9
}
DEF table2_math Table {
  translation -2.28 1.5 0
  name "table2_math"
  size 0.9 1.6 0.9
}
DEF RED_BOX_MATH Solid {
  translation -1.55 1.7 0.955
  children [
    Shape {
      appearance PBRAppearance { baseColor 0 1 0 roughness 0.5 }
      geometry Box { size 0.05 0.05 0.1 }
    }
  ]
  name "red_box_math"
  boundingObject Box { size 0.05 0.05 0.1 }
  physics Physics { density 500 }
}
DEF BLUE_TRAY_MATH Solid {
  translation -1.55 1.3 0.901
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.1 0.3 1 transparency 0.3 roughness 0.8 }
      geometry Box { size 0.25 0.25 0.01 }
    }
  ]
  name "blue_tray_math"
  boundingObject Box { size 0.25 0.25 0.01 }
}
