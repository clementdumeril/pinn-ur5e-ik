#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Parquetry.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/tables/protos/Table.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/universal_robots/protos/UR5e.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/devices/robotiq/protos/Robotiq3fGripper.proto"

WorldInfo {
  basicTimeStep 16
  coordinateSystem "ENU"
}

Viewpoint {
  orientation -0.25 -0.15 0.95 3.85
  position 1.2 0.0 4.2
}

TexturedBackground {
  texture "factory"
}

TexturedBackgroundLight {
  luminosity 0.7
}

RectangleArena {
  floorSize 12 12
  floorTileSize 2 2
  floorAppearance Parquetry {
    type "light strip"
  }
  wallHeight 1.2
}

# ==========================================================================
#  POSTE 1 (HAUT, Y = +1.2m) — ROBOT A : OPTION A (Trigo / DH Analytique)
# ==========================================================================
UR5e {
  name "UR5e_OptionA"
  translation -2.28 1.20 0.9
  rotation 0 0 -1 -1.570795
  controller "multi_controller"
  supervisor TRUE
  toolSlot [
    Robotiq3fGripper {
    }
    Camera {
      name "camera"
      translation 0 0 0.05
      rotation 1 0 0 1.5708
      fieldOfView 0.8
      width 256
      height 256
    }
  ]
}

DEF RED_BOX_A Solid {
  name "RED_BOX_A"
  translation -1.55 1.45 0.92
  children [
    DEF RED_SHAPE Shape {
      appearance PBRAppearance { baseColor 0.9 0.05 0.05 roughness 0.3 }
      geometry Box { size 0.04 0.04 0.04 }
    }
  ]
  boundingObject USE RED_SHAPE
  physics Physics { density -1 mass 0.04 }
}

DEF BLUE_TRAY_A Solid {
  name "BLUE_TRAY_A"
  translation -1.55 0.95 0.91
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.1 0.3 0.8 roughness 0.4 }
      geometry Box { size 0.16 0.16 0.02 }
    }
  ]
  boundingObject Box { size 0.16 0.16 0.02 }
}

Table {
  name "table1_A"
  translation -1.5 1.20 0
  size 0.8 1.4 0.9
}
Table {
  name "table2_A"
  translation -2.42 1.20 0
  size 0.8 1.4 0.9
}

