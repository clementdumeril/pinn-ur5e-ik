#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/universal_robots/protos/UR5e.proto"

WorldInfo {
  basicTimeStep 8
  coordinateSystem "ENU"
  contactProperties [
    ContactProperties {
      material1 "finger_mat"
      material2 "box_mat"
      coulombFriction [ 3.0 ]
      bounce 0.0
    }
    ContactProperties {
      material1 "default"
      material2 "box_mat"
      coulombFriction [ 0.8 ]
      bounce 0.0
    }
    ContactProperties {
      material1 "finger_mat"
      material2 "default"
      coulombFriction [ 1.0 ]
    }
  ]
}

Viewpoint {
  fieldOfView 0.83
  orientation 0.18 -0.22 -0.96 2.15
  position 1.8 1.4 1.4
}

TexturedBackground {
}

TexturedBackgroundLight {
}

DirectionalLight {
  direction 0 0 -1
  intensity 3
  castShadows FALSE
}

PointLight {
  location 0.50 0 1.5
  intensity 5
  attenuation 0 0 1
}

# ===================== Sol =====================
Solid {
  name "floor"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.8 0.8
        roughness 0.8
      }
      geometry Plane {
        size 10 10
      }
    }
  ]
  boundingObject Plane {
    size 10 10
  }
}

# ===================== Socle du UR5e (Hauteur 0.45m) =====================
Solid {
  name "pedestal"
  translation 0 0 0.225
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.25 0.25 0.28
        roughness 0.4
        metalness 0.8
      }
      geometry Box {
        size 0.26 0.26 0.45
      }
    }
  ]
  boundingObject Box {
    size 0.26 0.26 0.45
  }
}

# ===================== Table de travail (x = 0.50m, hauteur 0.30m) =====================
Solid {
  name "table"
  translation 0.50 0 0.15
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.55 0.4 0.28
        roughness 0.6
      }
      geometry Box {
        size 0.50 0.50 0.30
      }
    }
  ]
  boundingObject Box {
    size 0.50 0.50 0.30
  }
}

# ===================== Cube rouge cible (x = 0.50, y = 0.10, z = 0.32) =====================
DEF RED_BOX Solid {
  name "RED_BOX"
  translation 0.50 0.10 0.32
  contactMaterial "box_mat"
  children [
    DEF BOX_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.05 0.05
        roughness 0.3
        metalness 0
      }
      geometry Box {
        size 0.04 0.04 0.04
      }
    }
  ]
}

# ===================== OBSTACLE (sphere orange, statique, sur le chemin) =====================
# Deplacez-le a la souris : le PINN lit sa position en direct et replanifie.
DEF OBSTACLE Solid {
  name "OBSTACLE"
  translation 0.262 -0.04 0.661
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 0.55 0
        transparency 0.15
        roughness 0.5
      }
      geometry DEF OBS_SPHERE Sphere {
        radius 0.09
      }
    }
  ]
}

# ===================== Camera fixe au-dessus de la table =====================
Robot {
  name "OverheadCamera"
  controller "overhead_vision"
  supervisor TRUE
  children [
    Camera {
      name "overhead_camera"
      translation 0.50 0 1.20
      rotation 0 1 0 1.5708
      fieldOfView 0.9
      width 320
      height 240
    }
  ]
}

# ==========================================================================
#  UR5e — bras monte a z = 0.45 m, controle par le PINN IK sous contraintes
# ==========================================================================
UR5e {
  name "UR5e"
  translation 0 0 0.45
  controller "pinn_ik_avoidance"
  supervisor TRUE
  toolSlot [
    DEF TOOL Solid {
      name "gripper"
      children [
        Shape {
          appearance DEF METAL PBRAppearance {
            baseColor 0.18 0.18 0.2
            metalness 0.9
            roughness 0.3
          }
          geometry Box {
            size 0.08 0.08 0.04
          }
        }
        Transform {
          translation 0 0.03 0.06
          children [
            Shape {
              appearance USE METAL
              geometry Box {
                size 0.02 0.015 0.06
              }
            }
          ]
        }
        Transform {
          translation 0 -0.03 0.06
          children [
            Shape {
              appearance USE METAL
              geometry Box {
                size 0.02 0.015 0.06
              }
            }
          ]
        }
        Camera {
          name "camera"
          translation 0 0 0.05
          rotation 1 0 0 1.5708
          fieldOfView 0.9
          width 320
          height 240
        }
      ]
    }
  ]
}
